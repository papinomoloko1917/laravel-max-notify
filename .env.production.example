# This file contains examples only. Copy it to .env.production on the server.
# Never commit .env.production or real credentials.
COMPOSE_PROJECT_NAME=max-notify
SERVER_IP=10.10.0.50

APP_NAME="MAX Notify"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://10.10.0.50
APP_TIMEZONE=Europe/Moscow
APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=max_notify
DB_USERNAME=max_notify
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
QUEUE_SLEEP=1

MAIL_MAILER=log

# The Camera/NVR uses this HTTP address. Only /webhooks/dahua is served on port 80.
DAHUA_WEBHOOK_BASE_URL=http://10.10.0.50
DAHUA_CONNECT_TIMEOUT=3
DAHUA_TIMEOUT=10
DAHUA_WEBHOOK_USERNAME_LIMIT_PER_MINUTE=60
DAHUA_WEBHOOK_IP_LIMIT_PER_MINUTE=300
CAMERA_EVENT_RETENTION_DAYS=30

MAX_BASE_URL=https://platform-api2.max.ru
# Optional initial/fallback token. Prefer saving it through the admin UI after installation.
MAX_TOKEN=
MAX_CONNECT_TIMEOUT=3
MAX_TIMEOUT=10

